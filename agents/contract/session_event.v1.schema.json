{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhysioTrack Agent Insights v1",
  "description": "Output sent from n8n back to FastAPI after multi-agent analysis",
  "type": "object",
  "required": ["contract_version", "request_id", "session_id", "metrics", "assessment", "progress", "review", "coaching", "meta"],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^1\\."
    },
    "request_id": {
      "type": "string",
      "description": "Matches the request_id from the session event"
    },
    "session_id": {
      "type": "integer"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "reps_vs_target_pct": { "type": ["number", "null"] },
        "rom_vs_target_pct": { "type": ["number", "null"] },
        "fault_counts": { "type": "object" },
        "fast_rep_share": { "type": ["number", "null"] },
        "rom_slope_deg_per_session": { "type": ["number", "null"] },
        "baseline_rom": { "type": ["number", "null"] },
        "quality_band": { "type": ["string", "null"] },
        "incomplete_attempts": { "type": "integer" },
        "sessions_in_history": { "type": "integer" }
      }
    },
    "assessment": {
      "type": "object",
      "required": ["quality_band", "summary_for_physio"],
      "properties": {
        "quality_band": {
          "type": "string",
          "enum": ["good", "fair", "poor", "unknown"]
        },
        "summary_for_physio": { "type": "string" }
      }
    },
    "progress": {
      "type": "object",
      "required": ["trend", "summary_for_physio"],
      "properties": {
        "trend": {
          "type": "string",
          "enum": ["improving", "stable", "declining", "insufficient_data", "unknown"]
        },
        "summary_for_physio": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "required": ["needs_physio_attention", "flags"],
      "properties": {
        "needs_physio_attention": { "type": "boolean" },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "source"],
            "properties": {
              "code": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "source": {
                "type": "string",
                "enum": ["rule", "llm"]
              },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "coaching": {
      "type": "object",
      "required": ["patient_message", "status"],
      "properties": {
        "patient_message": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending_review", "approved", "rejected", "fallback", "needs_physio_rewrite"]
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["llm_status"],
      "properties": {
        "llm_status": {
          "type": "string",
          "enum": ["ok", "fallback"]
        },
        "latency_ms": { "type": "number" },
        "validation_errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "agent_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "message": { "type": "string" },
          "reply_summary": { "type": "string" }
        }
      }
    }
  }
}